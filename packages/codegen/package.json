{
  "name": "@x-requests/codegen",
  "version": "0.2.0",
  "description": "CLI that generates TypeScript route types for @x-requests/core from an OpenAPI document",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdanikeev/x-requests.git",
    "directory": "packages/codegen"
  },
  "homepage": "https://github.com/sdanikeev/x-requests#readme",
  "bugs": {
    "url": "https://github.com/sdanikeev/x-requests/issues"
  },
  "author": {
    "name": "Saveliy Anikeev"
  },
  "type": "module",
  "bin": {
    "x-requests": "./dist/cli.js"
  },
  "main": "./dist/Generator.js",
  "types": "./dist/Generator.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js"
  },
  "peerDependencies": {
    "openapi-typescript": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "openapi-typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "openapi",
    "codegen",
    "typescript",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
